# ==============================================================================
# TRUECHECK AI – ENVIRONMENT CONFIGURATION
# Hệ sinh thái kiểm chứng thông tin dựa trên bằng chứng (Evidence-Based AI)
# ==============================================================================

# --- 1. Google Gemini API (Trích xuất mệnh đề, Đánh giá bằng chứng & Embeddings) ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIM=768

# --- 2. Search & Fact-Check APIs (Truy xuất bằng chứng đa tầng) ---
# Google Fact Check Tools API (https://developers.google.com/fact-check/tools/api)
GOOGLE_FACTCHECK_API_KEY=your_google_factcheck_api_key_here

# Tavily Search API - Tối ưu truy xuất đoạn trích bằng chứng (https://tavily.com)
TAVILY_API_KEY=your_tavily_api_key_here

# Google Custom Search JSON API (Tùy chọn bổ sung cho Tavily)
GOOGLE_CSE_API_KEY=your_google_cse_api_key_here
GOOGLE_CSE_CX=your_programmable_search_engine_id_here

# --- 3. Database & Vector Store (PostgreSQL + pgvector) ---
POSTGRES_USER=truecheck
POSTGRES_PASSWORD=truecheck_secret
POSTGRES_DB=truecheck_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://truecheck:truecheck_secret@localhost:5432/truecheck_db

# Cho phép tự động fallback sang SQLite cục bộ nếu chưa bật Docker PostgreSQL
ALLOW_SQLITE_FALLBACK=true

# --- 4. Cache & Background Queue (Redis + Celery) ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- 5. Engine Guardrails & Privacy (Tuân thủ Luật BVDLCN 91/2025/QH15) ---
# Cho phép chạy chế độ Demo Heuristic khi chưa cấu hình API key để kiểm thử giao diện
ENABLE_DEMO_FALLBACK=true
CLAIM_MEMORY_SIMILARITY_THRESHOLD=0.90
CLAIM_MEMORY_TTL_DAYS=30
DOCUMENT_RETENTION_HOURS=24
MAX_UPLOAD_SIZE_MB=15

# --- 6. Service URLs ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,chrome-extension://*
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

